{
  "name": "@blockbuilders/credit-payment-widget",
  "version": "1.1.0",
  "description": "Payment Widget Plugin",
  "main": "dist/payment-widget.min.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist/*",
    "minify": "uglifyjs src/payment-widget.js -o dist/payment-widget.uglified.js -c -m",
    "obfuscate": "javascript-obfuscator src/payment-widget.js --output dist/payment-widget.min.js --config obfuscator.config.json",
    "build": "npm run clean && npm run obfuscate",
    "build:windows": "del /Q dist\\* 2>nul & npm run obfuscate",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "payment",
    "widget",
    "blockbuilders"
  ],
  "author": "Blockbuilders",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.0.0",
    "uglify-js": "^3.17.4"
  }
}
